<?xml version="1.0" encoding="utf-8"?>
<!-- Usage: dotnet publish TempApp -p:PublishProfile=win-x64 -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Bundle the few remaining native runtime DLLs too, so the output really is one exe -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <PublishDir>..\publish\</PublishDir>
    <!-- Note: PublishTrimmed is not supported for Windows Forms apps (NETSDK1175), so it's off. -->
  </PropertyGroup>
</Project>
